{
  "description": "bar chart on an OffscreenCanvas, which Chromium rasterizes slightly differently from bar.json",
  "config": {
    "type": "bar",
    "data": {
      "labels": ["a", "b", "c"],
      "datasets": [
        {
          "data": [3, 1, 2],
          "backgroundColor": "#36a2eb",
          "borderColor": "#1c6ea4",
          "borderWidth": 2
        }
      ]
    },
    "options": {
      "scales": {
        "x": { "display": false },
        "y": { "display": false, "beginAtZero": true }
      }
    }
  },
  "options": {
    "canvas": { "height": 256, "width": 256 },
    "useOffscreenCanvas": true
  }
}
