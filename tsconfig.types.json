{
  "compilerOptions": {
    "allowJs": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "types/generated",
    "rootDir": "src",
    "skipLibCheck": false,
    "strict": true,
    "target": "ES2022"
  },
  "include": ["src/**/*.js"]
}
